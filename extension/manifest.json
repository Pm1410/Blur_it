{
  "manifest_version": 3,
  "name": "AI/M.I. — A Layer Between You and the Noise",
  "version": "1.0.0",
  "description": "Privacy-preserving on-device content moderation. Filters toxic posts, blurs NSFW images, semantic topic filtering, and pre-post toxicity checking. Zero backend. All local.",
  "permissions": ["storage", "offscreen", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI/M.I. — Content Shield",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen.html", "offscreen.js", "worker.js",
        "ort.min.js", "ort-wasm-simd.wasm", "*.wasm",
        "models/*", "demo.html"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
