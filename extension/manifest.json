{
  "manifest_version": 3,
  "name": "CYHI Toxicity Filter",
  "version": "1.0",
  "description": "Checks drafts before they go out and offers polite rephrases, plus offline AI image filtering.",
  "permissions": ["scripting", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen.html", "offscreen.js",
        "ort.min.js", "ort-wasm-simd.wasm", "*.wasm",
        "models/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
