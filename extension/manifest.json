{
  "manifest_version": 3,
  "name": "Local NSFW Shield — On-Device Image Classifier",
  "version": "1.0.0",
  "description": "On-device, privacy-preserving CNN classifier that detects and blurs NSFW and Graphic images directly in the browser.",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local NSFW Shield",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "offscreen.html",
        "offscreen.js",
        "worker.js",
        "ort.min.js",
        "ort-wasm-simd.wasm",
        "*.wasm",
        "models/*",
        "demo_images/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
